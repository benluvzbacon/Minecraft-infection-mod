  },
  "license": "MIT",
  "icon": "assets/candyinfection/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.candyinfection.CandyInfection"
    ],
    "client": [
      "dev.candyinfection.client.CandyInfectionClient"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
